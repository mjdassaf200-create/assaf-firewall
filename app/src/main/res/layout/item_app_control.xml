<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_neon_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp"
    android:minHeight="176dp">

    <ImageView
        android:id="@+id/imgAppIcon"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="WhatsApp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAppStatus"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:background="@drawable/bg_status_connected"
        android:drawableStart="@drawable/ic_check_small"
        android:drawablePadding="3dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="متصل"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />

    <Switch
        android:id="@+id/switchAppControl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="3dp"
        android:showText="false"
        android:checked="true"
        android:thumbTint="#FFFFFF"
        android:trackTint="#1769B4"
        android:scaleX="0.82"
        android:scaleY="0.82" />
</LinearLayout>
