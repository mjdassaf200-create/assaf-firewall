<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_neon_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="9dp"
    android:minHeight="142dp">

    <ImageView
        android:id="@+id/imgAppIcon"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="WhatsApp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAppStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_status_connected"
            android:drawableStart="@drawable/ic_check_small"
            android:drawablePadding="3dp"
            android:paddingStart="5dp"
            android:paddingTop="5dp"
            android:paddingEnd="5dp"
            android:paddingBottom="5dp"
            android:maxLines="1"
            android:text="متصل"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Switch
            android:id="@+id/switchAppControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:showText="false"
            android:checked="true"
            android:thumbTint="#FFFFFF"
            android:trackTint="#168CFF" />
    </LinearLayout>
</LinearLayout>
